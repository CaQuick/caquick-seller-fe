    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "expo-doctor": "^1.20.4",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "istanbul-lib-coverage": "^3.2.2",
