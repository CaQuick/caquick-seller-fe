  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "types": "expo customize tsconfig.json",
    "lint": "pnpm types && eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm types && tsc --noEmit",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:check": "pnpm codegen && git diff --exit-code --stat -- src/graphql/generated",
    "schema:pull": "node scripts/schema-pull.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "coverage:merge": "tsx scripts/merge-coverage.ts",
    "doctor": "expo-doctor",
    "export": "expo export --platform all --output-dir .expo/export",
    "validate": "pnpm lint && pnpm typecheck && pnpm codegen:check && pnpm knip:check && pnpm test:cov && pnpm run doctor && pnpm export",
    "prepare": "husky",
    "knip:check": "knip"
  },
